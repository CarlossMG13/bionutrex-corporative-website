// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("admins")
}

model Slider {
  id            String   @id @default(cuid())
  title         String
  titleSegments String?  @db.Text
  subtitle      String?
  description   String?
  label         String?
  mediaType     String   @default("image")
  imageUrl      String
  videoUrl      String?
  videoMuted    Boolean  @default(true)
  accentColor   String   @default("#00e5ff")
  buttonText    String?
  buttonLink    String?
  button2Text   String?
  button2Link   String?
  stats         String?  @db.Text
  order         Int      @default(0)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("sliders")
}


model HomeSection {
  id            String   @id @default(cuid())
  sectionKey    String   @unique
  title         String
  subtitle      String?
  content       String   @db.Text
  imageUrl      String?
  buttonText    String?
  buttonLink    String?
  button2Text   String?
  button2Link   String?
  active        Boolean  @default(true)
  order         Int      @default(0)
  // Campos para secciones con hero (about, etc.)
  titleSegments String?  @db.Text
  accentColor   String?
  mediaType     String   @default("image")
  videoUrl      String?
  videoMuted    Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  images        SectionImage[]

  @@map("home_sections")
}


model SectionImage {
  id        String      @id @default(cuid())
  url       String
  alt       String
  caption   String?
  order     Int         @default(0)
  sectionId String
  section   HomeSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@map("section_images")
}

model BlogPost {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  excerpt     String
  content     String    @db.Text
  imageUrl    String
  author      String
  published   Boolean   @default(false)
  views       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?

  @@map("blog_posts")
}

model Product {
  id            String   @id @default(cuid())
  name          String
  price         Float
  imageUrl      String
  badge         String?
  badgeColor    String?  @default("#0d40a5")
  rating        Float    @default(5.0)
  reviewCount   Int      @default(0)
  featured      Boolean  @default(false)
  featuredOrder Int      @default(0)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("products")
}
